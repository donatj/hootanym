{
  "name": "hootanym",
  "version": "0.1.0",
  "description": "Take notes on HN users, see their Keybase.io profiles and more!",
  "main": "content.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "oxlint --config oxlint.config.mjs src",
    "lint:fix": "oxlint --config oxlint.config.mjs --fix src",
    "format": "oxfmt --config oxfmt.config.mjs --ignore-path .oxfmtignore --write src",
    "format:check": "oxfmt --config oxfmt.config.mjs --ignore-path .oxfmtignore --check src"
  },
  "author": "Jesse G Donat <donatj@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@types/chrome": "^0.3.2"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rollup": "^4.66.0",
    "sass": "^1.105.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
